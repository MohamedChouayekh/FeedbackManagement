@model FeedbackManagement.Models.Entities.Feedback

@using (Html.BeginForm("EditStatus", "Feedback", FormMethod.Post, new { id = "editStatusForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.StatusId, "Statut")
        @Html.DropDownList("StatusId", (SelectList)ViewBag.StatusId, "Choisir un statut", new { @class = "form-control" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Comment, "Commentaire")
        @Html.TextAreaFor(m => m.Comment, new { @class = "form-control", rows = 3 })
    </div>

    <div class="d-flex justify-content-end">
        <button type="button" id="saveStatusBtn" class="btn btn-primary">Enregistrer</button>
        <button type="button" class="btn btn-secondary ms-2" data-bs-dismiss="modal">Annuler</button>
    </div>
}
